generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationEnrollmentPolicy {
  ASSIGNMENT_ONLY
  ASSIGNMENT_AND_SELF_ENROLLMENT
}

enum OrganizationRole {
  ADMIN
  MANAGER
  LEARNER
}

enum UserStatus {
  INVITED
  ACTIVE
  INACTIVE
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  DEPRECATED
  RETIRED
}

enum CourseType {
  NATIVE_VIDEO
  SCORM_1_2
}

enum AssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

model User {
  id              String                   @id @default(cuid())
  email           String                   @unique
  firstName       String
  lastName        String
  passwordHash    String?
  status          UserStatus               @default(INVITED)
  isPlatformOwner Boolean                  @default(false)
  memberships     OrganizationMembership[] @relation("UserMemberships")
  invitationTokens UserInvitationToken[]    @relation("UserInvitationTokens")
  passwordResetTokens PasswordResetToken[]  @relation("UserPasswordResetTokens")
  auditLogs       AuditLog[]               @relation("AuditActor")
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
}

model Organization {
  id                   String                       @id @default(cuid())
  name                 String
  slug                 String                       @unique
  logoUrl              String?
  primaryColor         String                       @default("#2563eb")
  accentColor          String                       @default("#14b8a6")
  allowedEmailDomains  String[]                     @default([])
  enrollmentPolicy     OrganizationEnrollmentPolicy @default(ASSIGNMENT_ONLY)
  globalLibraryEnabled Boolean                      @default(false)
  memberships          OrganizationMembership[]
  invitationTokens     UserInvitationToken[]
  categories           CourseCategory[]
  tags                 CourseTag[]
  courses              Course[]
  auditLogs            AuditLog[]
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
}

model OrganizationMembership {
  id                  String                   @id @default(cuid())
  organizationId      String
  userId              String
  managerMembershipId String?
  roles               OrganizationRole[]
  employeeId          String?
  department          String?
  title               String?
  status              UserStatus               @default(INVITED)
  organization        Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                User                     @relation("UserMemberships", fields: [userId], references: [id], onDelete: Cascade)
  managerMembership   OrganizationMembership?  @relation("MembershipManager", fields: [organizationId, managerMembershipId], references: [organizationId, id], onDelete: NoAction)
  directReports       OrganizationMembership[] @relation("MembershipManager")
  invitationTokens    UserInvitationToken[]
  learningAssignments CourseAssignment[]       @relation("LearnerAssignments")
  assignedAssignments CourseAssignment[]       @relation("AssignedByMembership")
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@unique([organizationId, userId])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, managerMembershipId])
}

model UserInvitationToken {
  id             String                 @id @default(cuid())
  organizationId String
  membershipId   String
  userId         String
  tokenHash      String                 @unique
  expiresAt      DateTime
  usedAt         DateTime?
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership     OrganizationMembership @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Cascade)
  user           User                   @relation("UserInvitationTokens", fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime               @default(now())

  @@index([organizationId])
  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation("UserPasswordResetTokens", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model CourseCategory {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  slug           String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  courses        Course[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, slug])
  @@unique([organizationId, id])
}

model CourseTag {
  id             String          @id @default(cuid())
  organizationId String
  name           String
  slug           String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  courseLinks    CourseTagLink[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([organizationId, slug])
  @@unique([organizationId, id])
}

model Course {
  id                              String             @id @default(cuid())
  organizationId                  String
  title                           String
  slug                            String
  description                     String             @default("")
  status                          CourseStatus       @default(DRAFT)
  type                            CourseType
  estimatedCompletionBusinessDays Int                @default(5)
  expectedDurationMinutes         Int                @default(60)
  categoryId                      String?
  organization                    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category                        CourseCategory?    @relation(fields: [organizationId, categoryId], references: [organizationId, id])
  tagLinks                        CourseTagLink[]
  assignments                     CourseAssignment[]
  createdAt                       DateTime           @default(now())
  updatedAt                       DateTime           @updatedAt

  @@unique([organizationId, slug])
  @@unique([organizationId, id])
  @@index([organizationId, status])
}

model CourseTagLink {
  organizationId String
  courseId       String
  tagId          String
  course         Course    @relation(fields: [organizationId, courseId], references: [organizationId, id], onDelete: Cascade)
  tag            CourseTag @relation(fields: [organizationId, tagId], references: [organizationId, id], onDelete: Cascade)
  createdAt      DateTime  @default(now())

  @@id([organizationId, courseId, tagId])
  @@index([organizationId, tagId])
}

model CourseAssignment {
  id                     String                  @id @default(cuid())
  organizationId         String
  courseId               String
  membershipId           String
  assignedByMembershipId String?
  startDate              DateTime
  dueDate                DateTime
  status                 AssignmentStatus        @default(ASSIGNED)
  course                 Course                  @relation(fields: [organizationId, courseId], references: [organizationId, id], onDelete: Cascade)
  membership             OrganizationMembership  @relation("LearnerAssignments", fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Cascade)
  assignedByMembership   OrganizationMembership? @relation("AssignedByMembership", fields: [organizationId, assignedByMembershipId], references: [organizationId, id], onDelete: NoAction)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@index([organizationId])
  @@index([organizationId, courseId])
  @@index([organizationId, membershipId])
  @@index([organizationId, assignedByMembershipId])
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  actorId        String?
  action         String
  targetType     String
  targetId       String
  metadata       Json          @default("{}")
  organization   Organization? @relation(fields: [organizationId], references: [id])
  actor          User?         @relation("AuditActor", fields: [actorId], references: [id])
  createdAt      DateTime      @default(now())

  @@index([organizationId])
  @@index([actorId])
  @@index([action])
}
