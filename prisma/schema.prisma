generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationEnrollmentPolicy {
  ASSIGNMENT_ONLY
  ASSIGNMENT_AND_SELF_ENROLLMENT
}

enum OrganizationRole {
  ADMIN
  MANAGER
  LEARNER
}

enum UserStatus {
  INVITED
  ACTIVE
  INACTIVE
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  DEPRECATED
  RETIRED
}

enum CourseType {
  NATIVE_VIDEO
  SCORM_1_2
}

enum AssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum LearningEventSource {
  NATIVE
  SCORM
}

enum LearningEventType {
  PROGRESS
  COMPLETED
  PASSED
  FAILED
}

enum CredentialProviderName {
  CREDLY
}

enum CredentialIssuanceStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model User {
  id              String                   @id @default(cuid())
  email           String                   @unique
  firstName       String
  lastName        String
  passwordHash    String?
  status          UserStatus               @default(INVITED)
  isPlatformOwner Boolean                  @default(false)
  memberships     OrganizationMembership[] @relation("UserMemberships")
  invitationTokens UserInvitationToken[]    @relation("UserInvitationTokens")
  passwordResetTokens PasswordResetToken[]  @relation("UserPasswordResetTokens")
  uploadedScormPackages ScormPackage[]
  auditLogs       AuditLog[]               @relation("AuditActor")
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
}

model Organization {
  id                   String                       @id @default(cuid())
  name                 String
  slug                 String                       @unique
  logoUrl              String?
  primaryColor         String                       @default("#2563eb")
  accentColor          String                       @default("#14b8a6")
  allowedEmailDomains  String[]                     @default([])
  enrollmentPolicy     OrganizationEnrollmentPolicy @default(ASSIGNMENT_ONLY)
  globalLibraryEnabled Boolean                      @default(false)
  memberships          OrganizationMembership[]
  invitationTokens     UserInvitationToken[]
  categories           CourseCategory[]
  tags                 CourseTag[]
  courses              Course[]
  courseModules        CourseModule[]
  videoLessons         VideoLesson[]
  videoChapters        VideoChapter[]
  videoTranscriptCues  VideoTranscriptCue[]
  videoLessonProgress  VideoLessonProgress[]
  scormPackages        ScormPackage[]
  scormRegistrations   ScormRegistration[]
  assignmentProgresses AssignmentProgress[]
  learningEvents       LearningProgressEvent[]
  certificates         Certificate[]
  credentialIssuances  CredentialIssuance[]
  auditLogs            AuditLog[]
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
}

model OrganizationMembership {
  id                  String                   @id @default(cuid())
  organizationId      String
  userId              String
  managerMembershipId String?
  roles               OrganizationRole[]
  employeeId          String?
  department          String?
  title               String?
  status              UserStatus               @default(INVITED)
  organization        Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                User                     @relation("UserMemberships", fields: [userId], references: [id], onDelete: Cascade)
  managerMembership   OrganizationMembership?  @relation("MembershipManager", fields: [organizationId, managerMembershipId], references: [organizationId, id], onDelete: NoAction)
  directReports       OrganizationMembership[] @relation("MembershipManager")
  invitationTokens    UserInvitationToken[]
  learningAssignments CourseAssignment[]       @relation("LearnerAssignments")
  assignedAssignments CourseAssignment[]       @relation("AssignedByMembership")
  certificates        Certificate[]            @relation("MembershipCertificates")
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@unique([organizationId, userId])
  @@unique([organizationId, id])
  @@unique([organizationId, id, userId])
  @@index([organizationId])
  @@index([organizationId, managerMembershipId])
}

model UserInvitationToken {
  id             String                 @id @default(cuid())
  organizationId String
  membershipId   String
  userId         String
  tokenHash      String                 @unique
  expiresAt      DateTime
  usedAt         DateTime?
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership     OrganizationMembership @relation(fields: [organizationId, membershipId, userId], references: [organizationId, id, userId], onDelete: Cascade)
  user           User                   @relation("UserInvitationTokens", fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime               @default(now())

  @@index([organizationId])
  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation("UserPasswordResetTokens", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model CourseCategory {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  slug           String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  courses        Course[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, slug])
  @@unique([organizationId, id])
}

model CourseTag {
  id             String          @id @default(cuid())
  organizationId String
  name           String
  slug           String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  courseLinks    CourseTagLink[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([organizationId, slug])
  @@unique([organizationId, id])
}

model Course {
  id                              String             @id @default(cuid())
  organizationId                  String
  title                           String
  slug                            String
  description                     String             @default("")
  status                          CourseStatus       @default(DRAFT)
  type                            CourseType
  estimatedCompletionBusinessDays Int                @default(5)
  expectedDurationMinutes         Int                @default(60)
  categoryId                      String?
  organization                    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category                        CourseCategory?    @relation(fields: [organizationId, categoryId], references: [organizationId, id])
  tagLinks                        CourseTagLink[]
  assignments                     CourseAssignment[]
  modules                         CourseModule[]
  videoLessons                    VideoLesson[]
  scormPackages                   ScormPackage[]
  certificates                    Certificate[]
  createdAt                       DateTime           @default(now())
  updatedAt                       DateTime           @updatedAt

  @@unique([organizationId, slug])
  @@unique([organizationId, id])
  @@index([organizationId, status])
}

model CourseTagLink {
  organizationId String
  courseId       String
  tagId          String
  course         Course    @relation(fields: [organizationId, courseId], references: [organizationId, id], onDelete: Cascade)
  tag            CourseTag @relation(fields: [organizationId, tagId], references: [organizationId, id], onDelete: Cascade)
  createdAt      DateTime  @default(now())

  @@id([organizationId, courseId, tagId])
  @@index([organizationId, tagId])
}

model CourseAssignment {
  id                     String                  @id @default(cuid())
  organizationId         String
  courseId               String
  membershipId           String
  assignedByMembershipId String?
  startDate              DateTime
  dueDate                DateTime
  status                 AssignmentStatus        @default(ASSIGNED)
  course                 Course                  @relation(fields: [organizationId, courseId], references: [organizationId, id], onDelete: Cascade)
  membership             OrganizationMembership  @relation("LearnerAssignments", fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Cascade)
  assignedByMembership   OrganizationMembership? @relation("AssignedByMembership", fields: [organizationId, assignedByMembershipId], references: [organizationId, id], onDelete: NoAction)
  progress               AssignmentProgress?
  learningEvents         LearningProgressEvent[]
  videoProgress          VideoLessonProgress[]
  scormRegistration      ScormRegistration?
  certificate            Certificate?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@unique([organizationId, id])
  @@unique([organizationId, courseId, id])
  @@index([organizationId])
  @@index([organizationId, courseId])
  @@index([organizationId, membershipId])
  @@index([organizationId, assignedByMembershipId])
  @@unique([organizationId, courseId, membershipId])
}

model CourseModule {
  id             String        @id @default(cuid())
  organizationId String
  courseId       String
  title          String
  slug           String
  sortOrder      Int           @default(0)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  course         Course        @relation(fields: [organizationId, courseId], references: [organizationId, id], onDelete: Cascade)
  lessons        VideoLesson[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([organizationId, courseId, slug])
  @@unique([organizationId, id])
  @@unique([organizationId, courseId, id])
  @@index([organizationId, courseId, sortOrder])
}

model VideoLesson {
  id                 String                @id @default(cuid())
  organizationId     String
  courseId           String
  moduleId           String?
  title              String
  slug               String
  sortOrder          Int                   @default(0)
  durationSeconds    Int
  required           Boolean               @default(true)
  providerAssetId    String?
  playbackUrl        String?
  transcriptLanguage String                @default("en")
  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  course             Course                @relation(fields: [organizationId, courseId], references: [organizationId, id], onDelete: Cascade)
  module             CourseModule?         @relation(fields: [organizationId, courseId, moduleId], references: [organizationId, courseId, id], onDelete: NoAction)
  chapters           VideoChapter[]
  transcriptCues     VideoTranscriptCue[]
  progress           VideoLessonProgress[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@unique([organizationId, courseId, slug])
  @@unique([organizationId, id])
  @@unique([organizationId, courseId, id])
  @@index([organizationId, courseId, moduleId, sortOrder])
}

model VideoChapter {
  id             String       @id @default(cuid())
  organizationId String
  lessonId       String
  title          String
  startSecond    Int
  endSecond      Int?
  sortOrder      Int          @default(0)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lesson         VideoLesson  @relation(fields: [organizationId, lessonId], references: [organizationId, id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, lessonId, startSecond])
}

model VideoTranscriptCue {
  id             String       @id @default(cuid())
  organizationId String
  lessonId       String
  startSecond    Int
  endSecond      Int?
  text           String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lesson         VideoLesson  @relation(fields: [organizationId, lessonId], references: [organizationId, id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organizationId, lessonId, startSecond])
}

model VideoLessonProgress {
  id                 String           @id @default(cuid())
  organizationId     String
  courseId           String
  assignmentId       String
  lessonId           String
  lastPositionSecond Int              @default(0)
  maxWatchedSecond   Int              @default(0)
  completed          Boolean          @default(false)
  lastWatchedAt      DateTime?
  assignment         CourseAssignment @relation(fields: [organizationId, courseId, assignmentId], references: [organizationId, courseId, id], onDelete: Cascade)
  lesson             VideoLesson      @relation(fields: [organizationId, courseId, lessonId], references: [organizationId, courseId, id], onDelete: Cascade)
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([organizationId, assignmentId, lessonId])
  @@index([organizationId, courseId, assignmentId])
  @@index([organizationId, courseId, lessonId])
}

model AssignmentProgress {
  id              String           @id @default(cuid())
  organizationId  String
  assignmentId    String
  progressPercent Int              @default(0)
  lastEventAt     DateTime?
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignment      CourseAssignment @relation(fields: [organizationId, assignmentId], references: [organizationId, id], onDelete: Cascade)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([organizationId, assignmentId])
  @@index([organizationId])
}

model ScormPackage {
  id               String       @id @default(cuid())
  organizationId   String
  courseId         String
  originalFileName String
  contentType      String
  byteSize         Int
  storageKey       String
  launchPath       String
  manifestTitle    String?
  uploadedByUserId String?
  active           Boolean      @default(true)
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  course           Course       @relation(fields: [organizationId, courseId], references: [organizationId, id], onDelete: Cascade)
  uploadedBy       User?        @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  registrations    ScormRegistration[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([organizationId, courseId])
  @@unique([organizationId, id])
  @@index([organizationId, courseId])
  @@index([uploadedByUserId])
}

model ScormRegistration {
  id                    String           @id @default(cuid())
  organizationId        String
  assignmentId          String
  packageId             String
  cmiData               Json             @default("{}")
  lessonStatus          String           @default("not attempted")
  scoreRaw              Int?
  sessionTimeSeconds    Int              @default(0)
  totalTimeSeconds      Int              @default(0)
  launchCount           Int              @default(0)
  lastLaunchedAt        DateTime?
  lastCommittedAt       DateTime?
  organization          Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignment            CourseAssignment @relation(fields: [organizationId, assignmentId], references: [organizationId, id], onDelete: Cascade)
  package               ScormPackage     @relation(fields: [organizationId, packageId], references: [organizationId, id], onDelete: Cascade)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@unique([organizationId, assignmentId])
  @@index([organizationId, packageId])
}

model LearningProgressEvent {
  id              String              @id @default(cuid())
  organizationId  String
  assignmentId    String
  source          LearningEventSource
  type            LearningEventType
  progressPercent Int?
  rawPayload      Json                @default("{}")
  occurredAt      DateTime
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignment      CourseAssignment    @relation(fields: [organizationId, assignmentId], references: [organizationId, id], onDelete: Cascade)
  createdAt       DateTime            @default(now())

  @@index([organizationId, assignmentId])
  @@index([organizationId, occurredAt])
}

model Certificate {
  id                  String                 @id @default(cuid())
  organizationId      String
  assignmentId        String
  courseId            String
  membershipId        String
  userId              String
  learnerName         String
  learnerEmail        String
  courseTitle         String
  verificationCode    String                 @unique
  verificationUrl     String
  issuedAt            DateTime
  organization        Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignment          CourseAssignment       @relation(fields: [organizationId, assignmentId], references: [organizationId, id], onDelete: Cascade)
  course              Course                 @relation(fields: [organizationId, courseId], references: [organizationId, id], onDelete: Cascade)
  membership          OrganizationMembership @relation("MembershipCertificates", fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Cascade)
  credentialIssuances CredentialIssuance[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@unique([organizationId, assignmentId])
  @@index([organizationId])
  @@index([organizationId, membershipId])
  @@index([organizationId, courseId])
  @@index([userId])
}

model CredentialIssuance {
  id                   String                   @id @default(cuid())
  organizationId       String
  certificateId        String
  provider             CredentialProviderName
  status               CredentialIssuanceStatus @default(PENDING)
  providerCredentialId String?
  providerUrl          String?
  errorMessage         String?
  attemptedAt          DateTime                 @default(now())
  organization         Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  certificate          Certificate              @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([certificateId])
  @@index([organizationId, provider, status])
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  actorId        String?
  action         String
  targetType     String
  targetId       String
  metadata       Json          @default("{}")
  organization   Organization? @relation(fields: [organizationId], references: [id])
  actor          User?         @relation("AuditActor", fields: [actorId], references: [id])
  createdAt      DateTime      @default(now())

  @@index([organizationId])
  @@index([actorId])
  @@index([action])
}
